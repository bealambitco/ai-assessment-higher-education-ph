# OS and editor temporary files
.DS_Store
._*
Thumbs.db
~$*
*.swp

# Local secrets and private working material
.env
.env.*
!.env.example
private/
# local-only/ holds material set aside from the public tree (third-party full texts,
# unredacted originals, internal notes). Never publish it.
local-only/

# Reproducible dependencies and caches
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Agent/session state
.codex/
.agents/

# Local rendering/build intermediates
.tmp/
.cache/

# Never publish provider exports or credentials
openrouter_activity*.csv
*.key
*.pem
